import java.io.*;
import java.nio.file.*;

String log = new String(Files.readAllBytes(new File(basedir, "build.log").toPath()), "UTF-8");
String[] expected = {
    "byterails: rules    byterails.kts",
    "byterails: build    base package com.acme",
    "byterails: EXCLUSIVE    OrderList.java  com.acme.domain.OrderList.orders uses java.util.List; exclusive(\"java.util\") in pkg(\"com.acme.infra\") at byterails.kts:6",
    "byterails: rules of com.acme.domain: pkg(\"com.acme.domain\") at byterails.kts:3",
    "byterails:   allow(\"java.lang\") at the top of byterails.kts:2",
    "byterails: EXCLUSIVE    com.acme.domain uses java.util, which only com.acme.infra may use",
    "byterails: 1 violation, listed above; every reference is in target/byterails/violations.json and in the output of -Dbyterails.verbose=true"
};
for (String line : expected) {
    if (log.indexOf(line) < 0) {
        throw new RuntimeException("build.log is missing: " + line);
    }
}
return true;
