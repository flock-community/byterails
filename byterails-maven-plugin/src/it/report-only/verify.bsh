import java.io.*;
import java.nio.file.*;

String log = new String(Files.readAllBytes(new File(basedir, "build.log").toPath()), "UTF-8");
if (log.indexOf("byterails: 1 violation in 1 group, 3 classes, 2 packages") < 0) {
    throw new RuntimeException("build.log is missing the summary line");
}
String report = new String(Files.readAllBytes(new File(basedir, "target/byterails/violations.json").toPath()), "UTF-8");
if (report.indexOf("\"kind\": \"EXCLUSIVE\"") < 0) {
    throw new RuntimeException("the JSON report is missing the violation");
}
return true;
